{
  "name": "hollyland-web-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.scripts.json",
    "test:dsp": "vitest run src/lib/dsp",
    "test": "vitest run",
    "probe": "tsx scripts/probe.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "dsp:prepare": "bash tools/dsp-harness/prepare.sh",
    "dsp:native": ".dsp-native/bin/cmsis-runner",
    "dsp:compare": "tsx tools/dsp-harness/compare.ts",
    "typecheck:tools": "tsc -p tools/tsconfig.json && tsc -p tools/dsp-harness/browser/tsconfig.json",
    "bridge": "node scripts/bridge-launch.mjs",
    "dsp:browser": "tsx tools/dsp-harness/browser-check.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "@types/w3c-web-hid": "^1.0.7",
    "@types/ws": "^8.18.2",
    "node-hid": "^3.4.0",
    "puppeteer-core": "^25.16.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "usb": "^2.19.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/svelte": "^1.68.0"
  }
}
